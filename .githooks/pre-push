#!/bin/sh
# GitHub Actions only runs on demand, so this is the gate: the same checks CI ran, on this machine, before every push.
if [ -n "$SKIP_CI" ] || [ "$(git config --bool trakzen.skipci 2>/dev/null)" = "true" ]; then
  echo "pre-push: checks skipped (SKIP_CI or git config trakzen.skipci). Run them by hand with: node scripts/ci.mjs" >&2
  cat >/dev/null
  exit 0
fi
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushing=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] && continue
  pushing=1
  # An annotated tag arrives as the tag object's sha, so compare the commit it points at.
  if [ "$(git rev-parse "$lsha^{commit}" 2>/dev/null)" != "$head" ]; then
    echo "pre-push: the checks run on the checked-out tree, so check out the branch you are pushing first." >&2
    exit 1
  fi
done
[ "$pushing" = 0 ] && exit 0
if ! git diff --quiet HEAD --; then
  echo "pre-push: commit or stash your changes to tracked files first, so the checks test exactly what is pushed." >&2
  exit 1
fi
exec node scripts/ci.mjs
