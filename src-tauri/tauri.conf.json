{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trakzen Conecta",
  "version": "0.3.0",
  "identifier": "com.trakzen.conecta",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trakzen Conecta",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-hWMsav+abEA4p9dz+53zE8XpPa4nxdvbs2iNl9Z6lV8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http: cid:; font-src 'self' data:; frame-src 'self' about: data:; connect-src ipc: http://ipc.localhost; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
